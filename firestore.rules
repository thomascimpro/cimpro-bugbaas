rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function developer() {
      return signedIn()
        && (
          (request.auth.token.keys().hasAny(['admin']) && request.auth.token.admin == true)
          || (request.auth.token.keys().hasAny(['developer']) && request.auth.token.developer == true)
        );
    }

    function validStatus(status) {
      return status in ['Nieuw', 'Bevestigd', 'In behandeling', 'Gefixt', 'Afgekeurd', 'Dubbel'];
    }

    function validSeverity(severity) {
      return severity in ['Laag', 'Normaal', 'Hoog', 'Kritiek'];
    }

    function validNotificationType(type) {
      return type in ['trade', 'new_bug', 'comment', 'bug_update', 'bugdex', 'duel'];
    }

    function orgId(data) {
      return data.keys().hasAny(['organizationId']) ? data.organizationId : 'public';
    }

    function orgName(data) {
      return data.keys().hasAny(['organizationName']) ? data.organizationName : 'Public';
    }

    function currentOrgId() {
      return signedIn()
        ? orgId(get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
        : 'public';
    }

    function currentOrgIds() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.keys().hasAny(['organizationIds'])
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.organizationIds
        : [];
    }

    function userIsOrgMember(organizationId) {
      return signedIn()
        && organizationId is string
        && organizationId != 'public'
        && (
          currentOrgId() == organizationId
          || organizationId in currentOrgIds()
          || exists(/databases/$(database)/documents/organizations/$(organizationId)/members/$(request.auth.uid))
        );
    }

    function publicOrSameOrg(data) {
      return signedIn() && (orgId(data) == 'public' || userIsOrgMember(orgId(data)));
    }

    function currentUserEmail() {
      return signedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email
        : '';
    }

    function inviteTargetsCurrentUser(data) {
      return signedIn()
        && (
          data.invitedEmail == currentUserEmail()
          || (data.keys().hasAny(['invitedUserId']) && data.invitedUserId == request.auth.uid)
        );
    }

    function organizationAdmin(organizationId) {
      return signedIn()
        && organizationId is string
        && organizationId != 'public'
        && (
          get(/databases/$(database)/documents/organizations/$(organizationId)).data.createdBy == request.auth.uid
          || (
            exists(/databases/$(database)/documents/organizations/$(organizationId)/members/$(request.auth.uid))
            && get(/databases/$(database)/documents/organizations/$(organizationId)/members/$(request.auth.uid)).data.role in ['owner', 'admin']
          )
        );
    }

    function validInventoryData(bugId) {
      return request.resource.data.bugId == bugId
        && request.resource.data.count is int
      && request.resource.data.count >= 0
        && request.resource.data.firstUnlockedAt is string
        && request.resource.data.lastUnlockedAt is string
        && request.resource.data.rarity is string
        && request.resource.data.sources is list;
    }

    function validBugDexUnlockData(bugId) {
      return request.resource.data.keys().hasOnly(['bugId', 'firstUnlockedAt', 'lastTradeId', 'lastUnlockedAt', 'rarity', 'sources'])
        && request.resource.data.bugId == bugId
        && request.resource.data.firstUnlockedAt is string
        && request.resource.data.lastUnlockedAt is string
        && request.resource.data.rarity is string
        && request.resource.data.sources is list
        && (!request.resource.data.keys().hasAny(['lastTradeId']) || request.resource.data.lastTradeId is string);
    }

    function validBugMasteryData(bugId) {
      return request.resource.data.keys().hasOnly([
          'activeUses',
          'battleWins',
          'bugId',
          'dailySourceTotals',
          'duelUses',
          'lastXpAt',
          'lastTradeId',
          'level',
          'lifetimeXp',
          'rank',
          'role',
          'selectedSkillIds',
          'soloUses',
          'sourceTotals',
          'unlockedSkillIds',
          'updatedAt',
          'walkedKm',
          'xp'
        ])
        && request.resource.data.bugId == bugId
        && (!request.resource.data.keys().hasAny(['battleWins'])
          || (request.resource.data.battleWins is int
            && request.resource.data.battleWins >= 0
            && request.resource.data.battleWins <= 1000000))
        && request.resource.data.level is int
        && request.resource.data.level >= 1
        && request.resource.data.level <= 20
        && request.resource.data.xp is int
        && request.resource.data.xp >= 0
        && request.resource.data.lifetimeXp is int
        && request.resource.data.lifetimeXp >= 0
        && request.resource.data.rank in ['rookie', 'trained', 'skilled', 'veteran', 'elite', 'master']
        && request.resource.data.role in ['attack', 'speed', 'shield', 'chaos', 'support']
        && request.resource.data.unlockedSkillIds is list
        && request.resource.data.activeUses is int
        && request.resource.data.duelUses is int
        && request.resource.data.soloUses is int
        && request.resource.data.walkedKm is number
        && request.resource.data.sourceTotals is map
        && request.resource.data.updatedAt is string
        && (!request.resource.data.keys().hasAny(['dailySourceTotals']) || request.resource.data.dailySourceTotals is map)
        && (!request.resource.data.keys().hasAny(['lastXpAt']) || request.resource.data.lastXpAt is string)
        && (!request.resource.data.keys().hasAny(['lastTradeId']) || request.resource.data.lastTradeId is string)
        && (!request.resource.data.keys().hasAny(['selectedSkillIds']) || request.resource.data.selectedSkillIds is list);
    }

    function tradeMasteryCopy(userId, bugId) {
      return signedIn()
        && validBugMasteryData(bugId)
        && acceptedTradeData()
        && tradeGain(userId, bugId);
    }

    function validBugMasteryEventData(eventId) {
      return request.resource.data.keys().hasOnly(['amount', 'bugId', 'createdAt', 'id', 'kind', 'localDay', 'source'])
        && request.resource.data.id == eventId
        && request.resource.data.amount is int
        && request.resource.data.amount >= 0
        && request.resource.data.bugId is string
        && request.resource.data.createdAt is string
        && request.resource.data.localDay is string
        && (!request.resource.data.keys().hasAny(['kind']) || request.resource.data.kind == 'battle_win')
        && request.resource.data.source in [
          'active_squad_duel',
          'active_squad_solo',
          'boss_defeat',
          'buddy_care',
          'duplicate_unlock',
          'duel_draw',
          'duel_reward',
          'duel_win',
          'movement_radar',
          'new_unlock',
          'skill_trigger',
          'walking'
        ];
    }

    function validBugMasteryDailyData() {
      return request.resource.data.keys().hasOnly(['total', 'updatedAt'])
        && request.resource.data.total is int
        && request.resource.data.total >= 0
        && request.resource.data.total <= 220
        && request.resource.data.updatedAt is string;
    }

    function validArcadeMode(mode) {
      return mode in ['web_runner', 'nest_defense', 'bug_glide', 'butterfly_catch', 'bug_tower', 'bubble_swarm'];
    }

    function validArcadeResultMode(mode) {
      return validArcadeMode(mode) || mode == 'bubble_swarm';
    }

    function validDuelMode(mode) {
      return mode in ['tap_duel', 'web_runner', 'nest_defense', 'bug_glide', 'butterfly_catch', 'bug_tower', 'bubble_swarm'];
    }

    function isTaggedTapDuel(data) {
      return data.keys().hasAny(['arcadeMode']) && data.arcadeMode == 'tap_duel';
    }

    function isTapOrLegacyDuel(data) {
      return !data.keys().hasAny(['arcadeMode']) || isTaggedTapDuel(data);
    }

    function isNonTapArcadeDuel(data) {
      return data.keys().hasAny(['arcadeMode']) && validArcadeMode(data.arcadeMode);
    }

    function validRankedBugTowerRun(mode) {
      let data = request.resource.data;
      let hasRankedContext = data.keys().hasAny(['duelId', 'ranked']);
      return !hasRankedContext
        || (mode == 'bug_tower'
          && data.keys().hasAll(['duelId', 'ranked'])
          && data.duelId is string
          && data.ranked == true
          && exists(/databases/$(database)/documents/bugSmashDuels/$(data.duelId))
          && get(/databases/$(database)/documents/bugSmashDuels/$(data.duelId)).data.arcadeMode == 'bug_tower'
          && (get(/databases/$(database)/documents/bugSmashDuels/$(data.duelId)).data.fromUserId == request.auth.uid
            || get(/databases/$(database)/documents/bugSmashDuels/$(data.duelId)).data.toUserId == request.auth.uid)
          && get(/databases/$(database)/documents/bugSmashDuels/$(data.duelId)).data.scores.keys().hasAny([request.auth.uid])
          && get(/databases/$(database)/documents/bugSmashDuels/$(data.duelId)).data.scores[request.auth.uid].score == data.score);
    }

    function validArcadeRunData(mode) {
      return validArcadeResultMode(mode)
        && request.resource.data.keys().hasOnly(['combo', 'duelId', 'durationMs', 'hits', 'localHighScore', 'mode', 'pickups', 'ranked', 'score', 'streak', 'timestamp', 'userId'])
        && validRankedBugTowerRun(mode)
        && request.resource.data.mode == mode
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 100000000
        && request.resource.data.durationMs is int
        && request.resource.data.durationMs >= 0
        && request.resource.data.durationMs <= 21600000
        && (request.resource.data.score <= 50000
          || (mode in ['bug_tower', 'bubble_swarm'] && request.resource.data.durationMs > 90000))
        && (request.resource.data.durationMs <= 90000
          || mode in ['bug_tower', 'bubble_swarm', 'nest_defense'])
        && request.resource.data.pickups is int
        && request.resource.data.pickups >= 0
        && request.resource.data.hits is int
        && request.resource.data.hits >= 0
        && request.resource.data.combo is int
        && request.resource.data.combo >= 0
        && request.resource.data.streak is int
        && request.resource.data.streak >= 0
        && request.resource.data.localHighScore is int
        && request.resource.data.localHighScore >= 0
        && request.resource.data.localHighScore >= request.resource.data.score
        && request.resource.data.timestamp is string;
    }

    function acceptedTradeData() {
      return request.resource.data.lastTradeId is string
        && getAfter(/databases/$(database)/documents/trades/$(request.resource.data.lastTradeId)).data.status == 'Geaccepteerd'
        && getAfter(/databases/$(database)/documents/trades/$(request.resource.data.lastTradeId)).data.toUserId == request.auth.uid;
    }

    function tradeGain(userId, bugId) {
      let trade = getAfter(/databases/$(database)/documents/trades/$(request.resource.data.lastTradeId)).data;
      let offerBugIds = trade.keys().hasAll(['offerBugIds']) ? trade.offerBugIds : [trade.offerBugId];
      let requestBugIds = trade.keys().hasAll(['requestBugIds']) ? trade.requestBugIds : [trade.requestBugId];
      return (userId == trade.fromUserId && bugId in requestBugIds)
        || (userId == trade.toUserId && bugId in offerBugIds);
    }

    function tradeLoss(userId, bugId) {
      let trade = getAfter(/databases/$(database)/documents/trades/$(request.resource.data.lastTradeId)).data;
      let offerBugIds = trade.keys().hasAll(['offerBugIds']) ? trade.offerBugIds : [trade.offerBugId];
      let requestBugIds = trade.keys().hasAll(['requestBugIds']) ? trade.requestBugIds : [trade.requestBugId];
      return (userId == trade.fromUserId && bugId in offerBugIds)
        || (userId == trade.toUserId && bugId in requestBugIds);
    }

    function multiTrade(data) {
      return data.keys().hasAll(['offerBugIds', 'requestBugIds'])
        && (data.offerBugIds.size() > 1 || data.requestBugIds.size() > 1);
    }

    function maxTradeBugCountPerSide() {
      return 6;
    }

    function tradeInventoryCreate(userId, bugId) {
      return signedIn()
        && validInventoryData(bugId)
        && acceptedTradeData()
        && tradeGain(userId, bugId)
        && request.resource.data.count > 0
        && request.resource.data.count <= maxTradeBugCountPerSide();
    }

    function tradeInventoryUpdate(userId, bugId) {
      return signedIn()
        && validInventoryData(bugId)
        && acceptedTradeData()
        && (
          (
            tradeGain(userId, bugId)
            && request.resource.data.count > resource.data.count
            && request.resource.data.count <= resource.data.count + maxTradeBugCountPerSide()
          )
          || (
            tradeLoss(userId, bugId)
            && request.resource.data.count < resource.data.count
            && request.resource.data.count >= 0
            && request.resource.data.count >= resource.data.count - maxTradeBugCountPerSide()
          )
        );
    }

    function tradeUnlockCreate(userId, bugId) {
      return signedIn()
        && validBugDexUnlockData(bugId)
        && acceptedTradeData()
        && tradeGain(userId, bugId);
    }

    function tradeUnlockUpdate(userId, bugId) {
      return signedIn()
        && validBugDexUnlockData(bugId)
        && acceptedTradeData()
        && tradeGain(userId, bugId)
        && request.resource.data.firstUnlockedAt == resource.data.firstUnlockedAt;
    }

    function validUpvotes(data) {
      return data.upvoteUserIds is list
        && data.upvoteCount is int
        && data.upvoteCount == data.upvoteUserIds.size();
    }

    function onlyUpvoteFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvoteUserIds', 'upvoteCount', 'updatedAt']);
    }

    function firstLegacyUpvote() {
      return !resource.data.keys().hasAll(['upvoteUserIds', 'upvoteCount'])
        && validUpvotes(request.resource.data)
        && request.resource.data.upvoteCount == 1
        && request.auth.uid in request.resource.data.upvoteUserIds;
    }

    function toggledOwnUpvote() {
      return validUpvotes(resource.data)
        && validUpvotes(request.resource.data)
        && (
          (!(request.auth.uid in resource.data.upvoteUserIds)
            && request.auth.uid in request.resource.data.upvoteUserIds
            && request.resource.data.upvoteUserIds.size() == resource.data.upvoteUserIds.size() + 1
            && request.resource.data.upvoteUserIds.hasAll(resource.data.upvoteUserIds))
          ||
          (request.auth.uid in resource.data.upvoteUserIds
            && !(request.auth.uid in request.resource.data.upvoteUserIds)
            && resource.data.upvoteUserIds.size() == request.resource.data.upvoteUserIds.size() + 1
            && resource.data.upvoteUserIds.hasAll(request.resource.data.upvoteUserIds))
        );
    }

    function validBugCreate() {
      return request.resource.data.reporterId == request.auth.uid
        && (
          !request.resource.data.keys().hasAny(['organizationId'])
          || (request.resource.data.organizationId == 'public' && request.resource.data.organizationName == 'Public')
        )
        && request.resource.data.status == 'Nieuw'
        && validSeverity(request.resource.data.severity)
        && request.resource.data.title is string
        && request.resource.data.project is string
        && request.resource.data.description is string
        && validUpvotes(request.resource.data)
        && request.resource.data.upvoteCount == 0;
    }

    function validOrganizationBugCreate() {
      return request.resource.data.reporterId == request.auth.uid
        && request.resource.data.organizationId is string
        && request.resource.data.organizationId != 'public'
        && userIsOrgMember(request.resource.data.organizationId)
        && request.resource.data.organizationName is string
        && request.resource.data.status == 'Nieuw'
        && validSeverity(request.resource.data.severity)
        && request.resource.data.title is string
        && request.resource.data.project is string
        && request.resource.data.description is string
        && validUpvotes(request.resource.data)
        && request.resource.data.upvoteCount == 0;
    }

    function validUserUpdate(userId) {
      return signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && (
          (request.resource.data.organizationId == resource.data.organizationId
            && request.resource.data.organizationName == resource.data.organizationName)
          || (!request.resource.data.keys().hasAny(['organizationId'])
            && !resource.data.keys().hasAny(['organizationId']))
          || (!resource.data.keys().hasAny(['organizationId'])
            && request.resource.data.organizationId == 'public'
            && request.resource.data.organizationName == 'Public')
        )
        && request.resource.data.totalPoints is int
        && request.resource.data.totalPoints >= 0
        && (
          !request.resource.data.keys().hasAny(['bugCount'])
          || (request.resource.data.bugCount is int && request.resource.data.bugCount >= 0)
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'active',
          'activeBugSquad',
          'badges',
          'bugCount',
          'bugDexCount',
          'bugLampActiveUntil',
          'bugLampCount',
          'characterId',
          'commentPointCount',
          'displayName',
          'helpSeen',
          'lastActiveAt',
          'lastReportRewardDay',
          'legendaryBugDexCount',
          'movementKmTotal',
          'movementRegisteredDay',
          'movementRegisteredDayKm',
          'movementRegisteredWeek',
          'movementRegisteredWeekKm',
          'momentumCycle',
          'momentumLastActiveDay',
          'momentumSegments',
          'mythicBugDexCount',
          'nameSet',
          'notificationPushToken',
          'organizationId',
          'organizationIds',
          'organizationName',
          'organizationNames',
          'splatCount',
          'starterBoostActiveUntil',
          'starterBoostGrantedAt',
          'title',
          'totalPoints',
          'tradedBugDexCount',
          'upgradedBugDexCount',
          'upvoteGivenPointCount',
          'upvoteReceivedPointCount'
        ])
        && (!request.resource.data.keys().hasAny(['lastActiveAt']) || request.resource.data.lastActiveAt is string)
        && (!request.resource.data.keys().hasAny(['lastReportRewardDay']) || request.resource.data.lastReportRewardDay is string)
        && (!request.resource.data.keys().hasAny(['momentumCycle']) || (request.resource.data.momentumCycle is int && request.resource.data.momentumCycle >= 0))
        && (!request.resource.data.keys().hasAny(['momentumLastActiveDay']) || request.resource.data.momentumLastActiveDay.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && (!request.resource.data.keys().hasAny(['momentumSegments']) || (request.resource.data.momentumSegments is int && request.resource.data.momentumSegments >= 0 && request.resource.data.momentumSegments <= 5))
        && (!request.resource.data.keys().hasAny(['notificationPushToken']) || request.resource.data.notificationPushToken is string)
        && (!request.resource.data.keys().hasAny(['starterBoostActiveUntil']) || request.resource.data.starterBoostActiveUntil is string)
        && (!request.resource.data.keys().hasAny(['starterBoostGrantedAt']) || request.resource.data.starterBoostGrantedAt is string)
        && (!request.resource.data.keys().hasAny(['active']) || request.resource.data.active == true);
    }

    function organizationCreateUserUpdate(userId) {
      let organization = getAfter(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)).data;
      return signedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['organizationId', 'organizationIds', 'organizationName', 'organizationNames'])
        && request.resource.data.organizationId is string
        && request.resource.data.organizationId != 'public'
        && request.resource.data.organizationName is string
        && request.resource.data.organizationId == organization.id
        && request.resource.data.organizationName == organization.name
        && request.resource.data.organizationIds is list
        && organization.id in request.resource.data.organizationIds
        && request.resource.data.organizationNames is map
        && request.resource.data.organizationNames[organization.id] == organization.name
        && organization.createdBy == request.auth.uid;
    }

    function organizationInviteUserUpdate(userId) {
      let invite = getAfter(/databases/$(database)/documents/organizationInvites/$(request.resource.data.organizationInviteId)).data;
      return signedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['organizationId', 'organizationIds', 'organizationInviteId', 'organizationName', 'organizationNames'])
        && request.resource.data.organizationInviteId is string
        && invite.status == 'accepted'
        && invite.acceptedById == request.auth.uid
        && (invite.invitedEmail == resource.data.email || (invite.keys().hasAny(['invitedUserId']) && invite.invitedUserId == request.auth.uid))
        && invite.organizationId in request.resource.data.organizationIds
        && request.resource.data.organizationNames is map
        && request.resource.data.organizationNames[invite.organizationId] == invite.organizationName;
    }

    function organizationRemoveMemberUpdate(userId) {
      return signedIn()
        && request.auth.uid != userId
        && organizationAdmin(resource.data.organizationId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['organizationId', 'organizationIds', 'organizationName', 'organizationNames']);
    }

    function validInviteCreate() {
      return signedIn()
        && organizationAdmin(request.resource.data.organizationId)
        && request.resource.data.keys().hasOnly([
          'createdAt',
          'id',
          'invitedById',
          'invitedByName',
          'invitedEmail',
          'invitedUserId',
          'invitedUserName',
          'organizationId',
          'organizationName',
          'status'
        ])
        && request.resource.data.id is string
        && request.resource.data.invitedById == request.auth.uid
        && request.resource.data.invitedByName is string
        && request.resource.data.invitedEmail is string
        && (!request.resource.data.keys().hasAny(['invitedUserId']) || request.resource.data.invitedUserId is string)
        && (!request.resource.data.keys().hasAny(['invitedUserName']) || request.resource.data.invitedUserName is string)
        && (request.resource.data.invitedEmail.size() > 0 || request.resource.data.keys().hasAny(['invitedUserId']))
        && request.resource.data.organizationName == get(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)).data.name
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt is string;
    }

    function cancelInvite() {
      return signedIn()
        && resource.data.status == 'open'
        && organizationAdmin(resource.data.organizationId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cancelledAt', 'status'])
        && request.resource.data.status == 'cancelled'
        && request.resource.data.cancelledAt is string;
    }

    function acceptInvite() {
      return signedIn()
        && resource.data.status == 'open'
        && inviteTargetsCurrentUser(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acceptedAt', 'acceptedById', 'status'])
        && request.resource.data.status == 'accepted'
        && request.resource.data.acceptedById == request.auth.uid
        && request.resource.data.acceptedAt is string;
    }

    function declineInvite() {
      return signedIn()
        && resource.data.status == 'open'
        && inviteTargetsCurrentUser(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['declinedAt', 'declinedById', 'status'])
        && request.resource.data.status == 'declined'
        && request.resource.data.declinedById == request.auth.uid
        && request.resource.data.declinedAt is string;
    }

    function renameInviteOrganizationUpdate() {
      return signedIn()
        && resource.data.status == 'open'
        && organizationAdmin(resource.data.organizationId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['organizationName'])
        && request.resource.data.organizationName == get(/databases/$(database)/documents/organizations/$(resource.data.organizationId)).data.name;
    }

    function reporterBugUpdate() {
      return publicOrSameOrg(resource.data)
        && resource.data.reporterId == request.auth.uid
        && request.resource.data.reporterId == resource.data.reporterId
        && validStatus(request.resource.data.status)
        && validSeverity(request.resource.data.severity)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'points', 'updatedAt']);
    }

    function upvoteUpdate() {
      return publicOrSameOrg(resource.data)
        && onlyUpvoteFieldsChanged()
        && resource.data.reporterId != request.auth.uid
        && (firstLegacyUpvote() || toggledOwnUpvote());
    }

    function isDuelParticipant(data) {
      return data.fromUserId == request.auth.uid || data.toUserId == request.auth.uid;
    }

    function duelBugCount() {
      return 56;
    }

    function validDuelCreate(duelId) {
      return signedIn()
        && request.resource.data.keys().hasOnly([
          'arcadeMode',
          'arcadeSeed',
          'arcadeVersion',
          'bugIds',
          'createdAt',
          'durationMs',
          'fromUserId',
          'fromUserName',
          'id',
          'matchType',
          'rewardClaimedBy',
          'resultSeenBy',
          'scores',
          'seed',
          'startAt',
          'status',
          'toUserId',
          'toUserName',
          'updatedAt'
        ])
        && request.resource.data.id == duelId
        && request.resource.data.fromUserId == request.auth.uid
        && (!request.resource.data.keys().hasAny(['arcadeMode']) || validDuelMode(request.resource.data.arcadeMode))
        && (!request.resource.data.keys().hasAny(['arcadeSeed']) || request.resource.data.arcadeSeed is string)
        && (!request.resource.data.keys().hasAny(['arcadeVersion']) || (request.resource.data.arcadeVersion is int && request.resource.data.arcadeVersion >= 1 && request.resource.data.arcadeVersion <= 20))
        && (
          isTapOrLegacyDuel(request.resource.data)
          || (
            request.resource.data.keys().hasAll(['arcadeSeed', 'arcadeVersion'])
            && request.resource.data.arcadeSeed.size() <= 160
          )
        )
        && request.resource.data.toUserId is string
        && request.resource.data.toUserId != request.auth.uid
        && request.resource.data.fromUserName is string
        && (!request.resource.data.keys().hasAny(['matchType']) || request.resource.data.matchType in ['direct', 'random'])
        && request.resource.data.toUserName is string
        && request.resource.data.status == 'pending'
        && (!request.resource.data.keys().hasAny(['startAt']) || request.resource.data.startAt is string)
        && request.resource.data.seed is int
        && request.resource.data.bugIds is list
        && request.resource.data.bugIds.size() == duelBugCount()
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string
        && request.resource.data.durationMs is int
        && (
          (request.resource.data.keys().hasAny(['arcadeMode'])
            && request.resource.data.arcadeMode == 'butterfly_catch'
            && request.resource.data.durationMs == 60000)
          || ((!request.resource.data.keys().hasAny(['arcadeMode'])
              || request.resource.data.arcadeMode != 'butterfly_catch')
            && request.resource.data.durationMs == 30000)
        )
        && request.resource.data.scores is map
        && request.resource.data.scores.size() == 0
        && request.resource.data.rewardClaimedBy is list
        && request.resource.data.rewardClaimedBy.size() == 0
        && request.resource.data.resultSeenBy is list
        && request.resource.data.resultSeenBy.size() == 0;
    }

    function acceptOrDeclineDuel() {
      return signedIn()
        && resource.data.status == 'pending'
        && resource.data.toUserId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'startAt'])
        && request.resource.data.status in ['accepted', 'declined']
        && request.resource.data.updatedAt is string
        && (
          request.resource.data.status == 'declined'
          || (request.resource.data.keys().hasAny(['startAt']) && request.resource.data.startAt is string)
        );
    }

    function claimOpenRandomDuel() {
      return signedIn()
        && resource.data.matchType == 'random'
        && resource.data.status == 'pending'
        && resource.data.toUserId == 'random'
        && resource.data.fromUserId != request.auth.uid
        && (!resource.data.keys().hasAny(['arcadeMode']) || validDuelMode(resource.data.arcadeMode))
        && (
          (
            isTapOrLegacyDuel(resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['startAt', 'status', 'toUserId', 'toUserName', 'updatedAt'])
          )
          || (
            isNonTapArcadeDuel(resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimedArcadeMode', 'startAt', 'status', 'toUserId', 'toUserName', 'updatedAt'])
            && request.resource.data.claimedArcadeMode == resource.data.arcadeMode
          )
        )
        && request.resource.data.status == 'accepted'
        && request.resource.data.toUserId == request.auth.uid
        && request.resource.data.toUserName is string
        && request.resource.data.startAt is string
        && request.resource.data.updatedAt is string;
    }

    function cancelOwnDuel() {
      return signedIn()
        && resource.data.status == 'pending'
        && resource.data.fromUserId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status == 'cancelled'
        && request.resource.data.updatedAt is string;
    }

    function submitOwnDuelScore() {
      let otherUserId = resource.data.fromUserId == request.auth.uid ? resource.data.toUserId : resource.data.fromUserId;
      let ownScore = request.resource.data.scores[request.auth.uid];
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return signedIn()
        && isDuelParticipant(resource.data)
        && (
          resource.data.status in ['accepted', 'completed']
          || (resource.data.status == 'pending' && resource.data.fromUserId == request.auth.uid)
        )
        && (
          changed.hasOnly(['scores', 'status', 'winnerId', 'updatedAt'])
          || (
            resource.data.matchType == 'random'
            && resource.data.status != 'completed'
            && request.resource.data.status == 'completed'
            && !resource.data.keys().hasAny(['ratingAppliedAt'])
            && changed.hasOnly(['scores', 'status', 'winnerId', 'updatedAt', 'ratingAppliedAt', 'ratingDeltas'])
            && request.resource.data.ratingAppliedAt is string
            && request.resource.data.ratingDeltas is map
            && request.resource.data.ratingDeltas.keys().hasOnly([resource.data.fromUserId, resource.data.toUserId])
            && request.resource.data.ratingDeltas.keys().hasAll([resource.data.fromUserId, resource.data.toUserId])
            && request.resource.data.ratingDeltas[resource.data.fromUserId] is int
            && request.resource.data.ratingDeltas[resource.data.fromUserId] >= -40
            && request.resource.data.ratingDeltas[resource.data.fromUserId] <= 40
            && request.resource.data.ratingDeltas[resource.data.toUserId] is int
            && request.resource.data.ratingDeltas[resource.data.toUserId] >= -40
            && request.resource.data.ratingDeltas[resource.data.toUserId] <= 40
          )
        )
        && (
          request.resource.data.status in ['accepted', 'completed']
          || (resource.data.status == 'pending' && request.resource.data.status == 'pending')
        )
        && request.resource.data.updatedAt is string
        && request.resource.data.scores is map
        && request.resource.data.scores.keys().hasOnly([resource.data.fromUserId, resource.data.toUserId])
        && request.resource.data.scores.keys().hasAny([request.auth.uid])
        && (!resource.data.scores.keys().hasAny([otherUserId]) || request.resource.data.scores[otherUserId] == resource.data.scores[otherUserId])
        && ownScore.score is int
        && ownScore.score >= 0
        && ownScore.score <= (resource.data.keys().hasAny(['arcadeMode']) && validArcadeMode(resource.data.arcadeMode) ? 100000000 : 1200)
        && ownScore.caughtBugIds is list
        && ownScore.caughtBugIds.size() <= duelBugCount()
        && ownScore.bonusScore is int
        && ownScore.bonusScore >= 0
        && ownScore.bonusScore <= 100
        && ownScore.submittedAt is string
        && (!request.resource.data.keys().hasAny(['winnerId']) || request.resource.data.winnerId is string);
    }

    function currentDuelRating(data) {
      return data.keys().hasAny(['duelRating']) ? data.duelRating : 1000;
    }

    function currentDuelWins(data) {
      return data.keys().hasAny(['duelWins']) ? data.duelWins : 0;
    }

    function currentDuelLosses(data) {
      return data.keys().hasAny(['duelLosses']) ? data.duelLosses : 0;
    }

    function currentDuelDraws(data) {
      return data.keys().hasAny(['duelDraws']) ? data.duelDraws : 0;
    }

    function duelRatingAfterDelta(data, delta) {
      return currentDuelRating(data) + delta < 100 ? 100 : currentDuelRating(data) + delta;
    }

    function randomDuelRatingUserUpdate(userId) {
      let duel = getAfter(/databases/$(database)/documents/bugSmashDuels/$(request.resource.data.duelRatingLastDuelId)).data;
      let delta = duel.ratingDeltas[userId];
      let isWinner = duel.winnerId == userId;
      let isDraw = !duel.keys().hasAny(['winnerId']) || duel.winnerId == '';
      return signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['duelDraws', 'duelLosses', 'duelRating', 'duelRatingLastDuelId', 'duelRatingUpdatedAt', 'duelWins'])
        && request.resource.data.duelRatingLastDuelId is string
        && request.resource.data.duelRatingUpdatedAt is string
        && duel.matchType == 'random'
        && duel.status == 'completed'
        && duel.ratingAppliedAt == request.resource.data.duelRatingUpdatedAt
        && duel.ratingDeltas is map
        && duel.ratingDeltas.keys().hasAll([userId])
        && (duel.fromUserId == userId || duel.toUserId == userId)
        && (duel.fromUserId == request.auth.uid || duel.toUserId == request.auth.uid)
        && delta is int
        && delta >= -40
        && delta <= 40
        && request.resource.data.duelRating is int
        && request.resource.data.duelRating == duelRatingAfterDelta(resource.data, delta)
        && request.resource.data.duelWins == currentDuelWins(resource.data) + (isWinner ? 1 : 0)
        && request.resource.data.duelLosses == currentDuelLosses(resource.data) + (!isWinner && !isDraw ? 1 : 0)
        && request.resource.data.duelDraws == currentDuelDraws(resource.data) + (isDraw ? 1 : 0);
    }

    function duelRatingDecayUserUpdate(userId) {
      return signedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['duelRating', 'duelRatingDecayThroughDay'])
        && request.resource.data.duelRating is int
        && request.resource.data.duelRating >= 1000
        && request.resource.data.duelRating < currentDuelRating(resource.data)
        && request.resource.data.duelRatingDecayThroughDay is string
        && request.resource.data.duelRatingDecayThroughDay.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function claimOwnDuelReward() {
      let previousSeen = resource.data.keys().hasAny(['resultSeenBy']) ? resource.data.resultSeenBy : [];
      return signedIn()
        && resource.data.status == 'completed'
        && isDuelParticipant(resource.data)
        && request.resource.data.updatedAt is string
        && resource.data.rewardClaimedBy is list
        && request.resource.data.rewardClaimedBy is list
        && !(request.auth.uid in resource.data.rewardClaimedBy)
        && request.auth.uid in request.resource.data.rewardClaimedBy
        && request.resource.data.rewardClaimedBy.size() == resource.data.rewardClaimedBy.size() + 1
        && request.resource.data.rewardClaimedBy.hasAll(resource.data.rewardClaimedBy)
        && (
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rewardClaimedBy', 'resultSeenBy', 'updatedAt'])
            && previousSeen is list
            && request.resource.data.resultSeenBy is list
            && !(request.auth.uid in previousSeen)
            && request.auth.uid in request.resource.data.resultSeenBy
            && request.resource.data.resultSeenBy.size() == previousSeen.size() + 1
            && request.resource.data.resultSeenBy.hasAll(previousSeen)
          )
          ||
          (
            resource.data.keys().hasAny(['winnerId'])
            && resource.data.winnerId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rewardClaimedBy', 'updatedAt'])
          )
        );
    }

    function acknowledgeDuelResult() {
      let previousSeen = resource.data.keys().hasAny(['resultSeenBy']) ? resource.data.resultSeenBy : [];
      return signedIn()
        && resource.data.status == 'completed'
        && isDuelParticipant(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resultSeenBy', 'updatedAt'])
        && request.resource.data.updatedAt is string
        && previousSeen is list
        && request.resource.data.resultSeenBy is list
        && !(request.auth.uid in previousSeen)
        && request.auth.uid in request.resource.data.resultSeenBy
        && request.resource.data.resultSeenBy.size() == previousSeen.size() + 1
        && request.resource.data.resultSeenBy.hasAll(previousSeen);
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email
        && (
          !request.resource.data.keys().hasAny(['organizationId'])
          || (request.resource.data.organizationId == 'public' && request.resource.data.organizationName == 'Public')
        )
        && (!request.resource.data.keys().hasAny(['active']) || request.resource.data.active == true);
      allow update: if signedIn()
        && (validUserUpdate(userId) || randomDuelRatingUserUpdate(userId) || duelRatingDecayUserUpdate(userId) || organizationCreateUserUpdate(userId) || organizationInviteUserUpdate(userId) || organizationRemoveMemberUpdate(userId));
      allow delete: if signedIn() && resource.data.reporterId == request.auth.uid;

      match /bugdex/{bugId} {
        allow read: if signedIn();
        allow create: if (signedIn()
          && request.auth.uid == userId
          && validInventoryData(bugId))
          || tradeInventoryCreate(userId, bugId);
        allow update: if (signedIn()
          && request.auth.uid == userId
          && validInventoryData(bugId))
          || tradeInventoryUpdate(userId, bugId);
        allow delete: if false;
      }

      match /bugdexUnlocks/{bugId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create: if (signedIn()
          && request.auth.uid == userId
          && validBugDexUnlockData(bugId))
          || tradeUnlockCreate(userId, bugId);
        allow update: if (signedIn()
          && request.auth.uid == userId
          && validBugDexUnlockData(bugId))
          || tradeUnlockUpdate(userId, bugId);
        allow delete: if false;
      }

      match /bugMastery/{bugId} {
        allow read: if signedIn();
        allow create, update: if signedIn()
          && (
            (request.auth.uid == userId && validBugMasteryData(bugId))
            || tradeMasteryCopy(userId, bugId)
          );
        allow delete: if false;
      }

      match /buddy/{buddyDocId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create, update: if signedIn()
          && request.auth.uid == userId
          && buddyDocId == 'state'
          && request.resource.data.keys().hasOnly(['bugId', 'care', 'updatedAt'])
          && request.resource.data.bugId is string
          && request.resource.data.care is map
          && request.resource.data.updatedAt is string;
        allow delete: if false;
      }

      match /bugMasteryEvents/{eventId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create: if signedIn()
          && request.auth.uid == userId
          && validBugMasteryEventData(eventId);
        allow update, delete: if false;
      }

      match /bugMasteryDaily/{dayId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create, update: if signedIn()
          && request.auth.uid == userId
          && dayId.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && validBugMasteryDailyData();
        allow delete: if false;
      }

      match /bugdexEvents/{eventId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.id == eventId
          && request.resource.data.source is string
          && request.resource.data.createdAt is string;
        allow update, delete: if false;
      }

      match /bugBrainDailyAttempts/{dayId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create: if signedIn()
          && request.auth.uid == userId
          && dayId.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && request.resource.data.keys().hasOnly(['day', 'seed', 'startedAt', 'status'])
          && request.resource.data.day == dayId
          && request.resource.data.seed is int
          && request.resource.data.seed >= 0
          && request.resource.data.startedAt is string
          && request.resource.data.status == 'active';
        allow update: if signedIn()
          && request.auth.uid == userId
          && resource.data.status == 'active'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completedAt', 'correctAnswers', 'status'])
          && request.resource.data.completedAt is string
          && request.resource.data.correctAnswers is int
          && request.resource.data.correctAnswers >= 0
          && request.resource.data.correctAnswers <= 10
          && request.resource.data.status == 'completed';
        allow delete: if false;
      }

      match /bugBrainDailyClaims/{dayId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create: if signedIn()
          && request.auth.uid == userId
          && dayId.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && request.resource.data.keys().hasOnly(['awardedXp', 'claimedAt', 'correctAnswers', 'day', 'rewardBugId', 'rewardTier'])
          && request.resource.data.day == dayId
          && request.resource.data.claimedAt is string
          && request.resource.data.correctAnswers is int
          && request.resource.data.correctAnswers >= 0
          && request.resource.data.correctAnswers <= 10
          && request.resource.data.awardedXp == request.resource.data.correctAnswers
          && get(/databases/$(database)/documents/users/$(userId)/bugBrainDailyAttempts/$(dayId)).data.status == 'active'
          && getAfter(/databases/$(database)/documents/users/$(userId)/bugBrainDailyAttempts/$(dayId)).data.status == 'completed'
          && getAfter(/databases/$(database)/documents/users/$(userId)/bugBrainDailyAttempts/$(dayId)).data.correctAnswers == request.resource.data.correctAnswers
          && getAfter(/databases/$(database)/documents/users/$(userId)).data.totalPoints == get(/databases/$(database)/documents/users/$(userId)).data.totalPoints + request.resource.data.awardedXp
          && (
            (
              request.resource.data.correctAnswers < 5
              && !request.resource.data.keys().hasAny(['rewardBugId', 'rewardTier'])
            )
            || (
              request.resource.data.correctAnswers >= 5
              && request.resource.data.correctAnswers <= 7
              && request.resource.data.keys().hasAll(['rewardBugId', 'rewardTier'])
              && request.resource.data.rewardTier == 'Zeldzaam'
            )
            || (
              request.resource.data.correctAnswers >= 8
              && request.resource.data.correctAnswers <= 9
              && request.resource.data.keys().hasAll(['rewardBugId', 'rewardTier'])
              && request.resource.data.rewardTier == 'Episch'
            )
            || (
              request.resource.data.correctAnswers == 10
              && request.resource.data.keys().hasAll(['rewardBugId', 'rewardTier'])
              && request.resource.data.rewardTier == 'Legendarisch'
            )
          )
          && (
            !request.resource.data.keys().hasAny(['rewardBugId'])
            || (
              request.resource.data.rewardBugId is string
              && getAfter(/databases/$(database)/documents/users/$(userId)/bugdex/$(request.resource.data.rewardBugId)).data.rarity == request.resource.data.rewardTier
              && getAfter(/databases/$(database)/documents/users/$(userId)/bugdex/$(request.resource.data.rewardBugId)).data.sources.hasAny(['bug_brain_daily'])
            )
          );
        allow update, delete: if false;
      }

      match /realBugScanUsage/{dayId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create, update, delete: if false;
      }

      match /realBugScanServerUsage/{dayId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create: if signedIn()
          && request.auth.uid == userId
          && dayId.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && request.resource.data.keys().hasOnly(['day', 'used', 'scanIds', 'updatedAt'])
          && request.resource.data.day == dayId
          && request.resource.data.used == 1
          && request.resource.data.scanIds is list
          && request.resource.data.scanIds.size() == 1
          && request.resource.data.scanIds[0] is string
          && request.resource.data.scanIds[0].matches('[a-zA-Z0-9_-]{8,100}')
          && request.resource.data.updatedAt is string;
        allow update: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['day', 'used', 'scanIds', 'updatedAt'])
          && request.resource.data.day == dayId
          && request.resource.data.used is int
          && request.resource.data.used == resource.data.used + 1
          && request.resource.data.used <= 3
          && request.resource.data.scanIds is list
          && request.resource.data.scanIds.size() == resource.data.scanIds.size() + 1
          && request.resource.data.scanIds.size() == request.resource.data.used
          && request.resource.data.scanIds.hasAll(resource.data.scanIds)
          && request.resource.data.scanIds[request.resource.data.scanIds.size() - 1] is string
          && request.resource.data.scanIds[request.resource.data.scanIds.size() - 1].matches('[a-zA-Z0-9_-]{8,100}')
          && request.resource.data.updatedAt is string;
        allow delete: if false;
      }

      match /realBugScanProgress/{dayId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create: if signedIn()
          && request.auth.uid == userId
          && dayId.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && request.resource.data.keys().hasOnly(['completed', 'completedAt', 'day', 'scanId', 'status', 'userId'])
          && request.resource.data.completed == true
          && request.resource.data.completedAt is string
          && request.resource.data.day == dayId
          && request.resource.data.scanId is string
          && request.resource.data.scanId.matches('[a-zA-Z0-9_-]{8,100}')
          && request.resource.data.status in ['matched', 'already_spotted', 'not_in_catalog', 'pending_review']
          && request.resource.data.userId == request.auth.uid;
        allow update, delete: if false;
      }

      match /fieldJournal/{entryId} {
        allow read: if false;
        allow create, update, delete: if false;
      }

      match /verifiedObservations/{entryId} {
        // Includes an optional server-written, rounded private map cell. Only its owner can read it.
        allow read: if signedIn() && request.auth.uid == userId;
        allow create, update, delete: if false;
      }

      match /museumPlacements/{wingId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create, update: if signedIn()
          && request.auth.uid == userId
          && wingId in ["beetles", "wings", "water", "night", "crawlers", "crown"]
          && request.resource.data.keys().hasOnly(["wingId", "placements", "updatedAt"])
          && request.resource.data.wingId == wingId
          && request.resource.data.placements is list
          && request.resource.data.placements.size() <= 6
          && request.resource.data.updatedAt is string;
        allow delete: if signedIn() && request.auth.uid == userId;
      }

      match /museumRewardClaims/{claimId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create, update, delete: if false;
      }

      match /research/{researchDocId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create, update, delete: if false;
      }

      match /researchEvidence/{evidenceId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create, update, delete: if false;
      }

      match /rewardReceipts/{receiptId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create, update, delete: if false;
      }

      match /fieldMilestoneClaims/{milestoneId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create, update, delete: if false;
      }

      match /releaseBossClaims/{bossId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create, update, delete: if false;
      }

      match /swarmSiegeClaims/{eventId} {
        allow read, create, update, delete: if false;
      }

      match /teamHuntContributions/{eventId} {
        allow read, create, update, delete: if false;
      }

      match /duelRewardEvents/{eventId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create: if signedIn()
          && request.auth.uid == userId
          && (
            eventId.matches('duel-daily-[0-9]{4}-[0-9]{2}-[0-9]{2}-.+')
            || eventId.matches('duel-.+')
          )
          && request.resource.data.keys().hasOnly([
            'createdAt',
            'day',
            'duelId',
            'minimumCount',
            'opponentId',
            'rewardBugId',
            'result'
          ])
          && request.resource.data.createdAt is string
          && request.resource.data.day is string
          && request.resource.data.duelId is string
          && request.resource.data.opponentId is string
          && request.resource.data.result in ['win', 'loss', 'draw']
          && (
            !request.resource.data.keys().hasAny(['rewardBugId', 'minimumCount'])
            || (
              request.resource.data.keys().hasAll(['rewardBugId', 'minimumCount'])
              && request.resource.data.result in ['win', 'draw']
              && request.resource.data.rewardBugId is string
              && request.resource.data.minimumCount is int
              && request.resource.data.minimumCount >= 1
            )
          );
        allow update, delete: if false;
      }

      match /weeklyMissionClaims/{claimId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create, update: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.id == claimId
          && request.resource.data.claimedAt is string
          && request.resource.data.keys().hasOnly([
            'claimedAt',
            'id',
            'missionIds',
            'missionTitle',
            'rewardBugId',
            'rewardGrantedAt',
            'rewardRarity',
            'rewardSource',
            'rewardType',
            'rewardXp'
          ]);
        allow delete: if false;
      }

      match /dailyMissionClaims/{claimId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create, update: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.id == claimId
          && request.resource.data.claimedAt is string
          && request.resource.data.rewardXp is int
          && request.resource.data.rewardXp >= 0
          && request.resource.data.keys().hasOnly([
            'claimedAt',
            'id',
            'localDay',
            'missionIds',
            'missionTitle',
            'rewardBugId',
            'rewardGrantedAt',
            'rewardRarity',
            'rewardSource',
            'rewardType',
            'rewardXp'
          ]);
        allow delete: if false;
      }

      match /duelSeasonClaims/{seasonId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create, update, delete: if false;
      }

      match /missionProgress/{progressId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create, update: if signedIn()
          && request.auth.uid == userId
          && progressId == 'soloCampaignBosses'
          && request.resource.data.keys().hasOnly([
            'dayCount',
            'dayId',
            'updatedAt',
            'weekCount',
            'weekId'
          ])
          && request.resource.data.dayCount is int
          && request.resource.data.dayId is string
          && request.resource.data.updatedAt is string
          && request.resource.data.weekCount is int
          && request.resource.data.weekId is string;
        allow delete: if false;
      }

      match /settings/{settingId} {
        allow read: if signedIn()
          && request.auth.uid == userId
          && settingId == 'notifications';
        allow create, update: if signedIn()
          && request.auth.uid == userId
          && settingId == 'notifications'
          && request.resource.data.trade is bool
          && request.resource.data.new_bug is bool
          && request.resource.data.comment is bool
          && request.resource.data.bug_update is bool
          && request.resource.data.bugdex is bool
          && request.resource.data.duel is bool;
        allow delete: if false;
      }

      match /soloCampaign/{progressId} {
        allow read: if signedIn()
          && request.auth.uid == userId
          && progressId == 'progress';
        allow create, update: if signedIn()
          && request.auth.uid == userId
          && progressId == 'progress'
          && request.resource.data.keys().hasOnly([
            'lives',
            'updatedAt',
            'wave',
            'weekId'
          ])
          && request.resource.data.lives is int
          && request.resource.data.lives >= 1
          && request.resource.data.lives <= 3
          && request.resource.data.updatedAt is string
          && request.resource.data.weekId is string
          && request.resource.data.wave is int
          && request.resource.data.wave >= 1
          && request.resource.data.wave <= 20;
        allow delete: if false;
      }

      match /notifications/{notificationId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create: if signedIn()
          && request.resource.data.id == notificationId
          && validNotificationType(request.resource.data.type)
          && request.resource.data.title is string
          && request.resource.data.body is string
          && request.resource.data.actorId == request.auth.uid
          && request.resource.data.actorName is string
          && request.resource.data.createdAt is string
          && request.resource.data.read == false;
        allow update: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
          && request.resource.data.read is bool;
        allow delete: if false;
      }
    }

    match /bugs/{bugId} {
      allow read: if signedIn();
      allow create: if signedIn() && validBugCreate();
      allow update: if signedIn() && (reporterBugUpdate() || upvoteUpdate());
      allow delete: if signedIn() && resource.data.reporterId == request.auth.uid;

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.bugId == bugId
          && (
            !request.resource.data.keys().hasAny(['organizationId'])
            || (request.resource.data.organizationId == 'public' && request.resource.data.organizationName == 'Public')
          )
          && request.resource.data.authorName is string
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 500
          && request.resource.data.reaction is string
          && request.resource.data.createdAt is string;
        allow update: if false;
        allow delete: if signedIn()
          && get(/databases/$(database)/documents/bugs/$(bugId)).data.reporterId == request.auth.uid;
      }
    }

    // Team Hunt data is written and aggregated only by authenticated Functions.
    // Clients use the status endpoint, so personal observations and the board cannot be forged or scraped.
    match /teamHunts/{eventId} {
      allow read, write: if false;
      match /teams/{organizationId} {
        allow read, write: if false;
        match /species/{speciesId} {
          allow read, write: if false;
        }
      }
    }

    // Swarm Siege is exposed only through authenticated Functions.
    // Clients cannot forge runs, damage, participant state or reward claims.
    match /swarmSieges/{eventId} {
      allow read, write: if false;
      match /participants/{userId} {
        allow read, write: if false;
      }
    }

    match /swarmSiegeRuns/{runId} {
      allow read, write: if false;
    }

    match /organizationBugs/{bugId} {
      allow read: if publicOrSameOrg(resource.data);
      allow create: if signedIn() && validOrganizationBugCreate();
      allow update: if signedIn() && (reporterBugUpdate() || upvoteUpdate());
      allow delete: if publicOrSameOrg(resource.data) && resource.data.reporterId == request.auth.uid;

      match /comments/{commentId} {
        allow read: if publicOrSameOrg(get(/databases/$(database)/documents/organizationBugs/$(bugId)).data);
        allow create: if signedIn()
          && publicOrSameOrg(get(/databases/$(database)/documents/organizationBugs/$(bugId)).data)
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.bugId == bugId
          && request.resource.data.organizationId == orgId(get(/databases/$(database)/documents/organizationBugs/$(bugId)).data)
          && request.resource.data.organizationName == orgName(get(/databases/$(database)/documents/organizationBugs/$(bugId)).data)
          && request.resource.data.authorName is string
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 500
          && request.resource.data.reaction is string
          && request.resource.data.createdAt is string;
        allow update: if false;
        allow delete: if signedIn()
          && publicOrSameOrg(get(/databases/$(database)/documents/organizationBugs/$(bugId)).data)
          && get(/databases/$(database)/documents/organizationBugs/$(bugId)).data.reporterId == request.auth.uid;
      }
    }

    match /organizations/{organizationId} {
      allow read: if signedIn()
        && userIsOrgMember(organizationId);
      allow create: if signedIn()
        && organizationId != 'public'
        && request.resource.data.keys().hasOnly(['createdAt', 'createdBy', 'createdByName', 'id', 'name'])
        && request.resource.data.id == organizationId
        && request.resource.data.name is string
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdByName is string
        && request.resource.data.createdAt is string;
      allow update: if signedIn()
        && organizationAdmin(organizationId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'updatedAt'])
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdByName == resource.data.createdByName
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.name is string
        && (!request.resource.data.keys().hasAny(['updatedAt']) || request.resource.data.updatedAt is string);
      allow delete: if signedIn()
        && organizationAdmin(organizationId);

      match /members/{memberId} {
        allow read: if userIsOrgMember(organizationId) || organizationAdmin(organizationId);
        allow create: if signedIn()
          && memberId == request.resource.data.uid
          && request.resource.data.organizationId == organizationId
          && request.resource.data.organizationName is string
          && request.resource.data.displayName is string
          && request.resource.data.email is string
          && request.resource.data.joinedAt is string
          && request.resource.data.role in ['owner', 'admin', 'member']
          && (
            (
              memberId == request.auth.uid
              && request.resource.data.role == 'owner'
              && getAfter(/databases/$(database)/documents/organizations/$(organizationId)).data.createdBy == request.auth.uid
            )
            || (
              memberId == request.auth.uid
              && request.resource.data.role == 'member'
              && request.resource.data.inviteId is string
              && getAfter(/databases/$(database)/documents/organizationInvites/$(request.resource.data.inviteId)).data.status == 'accepted'
              && getAfter(/databases/$(database)/documents/organizationInvites/$(request.resource.data.inviteId)).data.acceptedById == request.auth.uid
              && getAfter(/databases/$(database)/documents/organizationInvites/$(request.resource.data.inviteId)).data.organizationId == organizationId
            )
            || organizationAdmin(organizationId)
          );
        allow update, delete: if organizationAdmin(organizationId);
      }
    }

    match /pendingBugDexDiscoveries/{scanId} {
      allow create: if signedIn()
        && scanId.matches('[a-zA-Z0-9_-]{8,100}')
        && request.resource.data.keys().hasOnly([
          'scanId',
          'userId',
          'userDisplayName',
          'userEmail',
          'organizationId',
          'commonName',
          'commonNameEn',
          'commonNameFr',
          'scientificName',
          'fact',
          'factEn',
          'factFr',
          'normalizedSpeciesKey',
          'confidence',
          'reason',
          'reasonEn',
          'reasonFr',
          'createdAt',
          'updatedAt',
          'status',
          'bugDexBugId',
          'reviewThumbnailDataUrl'
        ])
        && request.resource.data.keys().hasAll([
          'scanId',
          'userId',
          'userDisplayName',
          'userEmail',
          'organizationId',
          'commonName',
          'scientificName',
          'normalizedSpeciesKey',
          'confidence',
          'reason',
          'createdAt',
          'updatedAt',
          'status',
          'bugDexBugId',
          'reviewThumbnailDataUrl'
        ])
        && request.resource.data.scanId == scanId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userDisplayName is string
        && request.resource.data.userDisplayName.size() <= 120
        && request.resource.data.userEmail is string
        && request.resource.data.userEmail.size() <= 180
        && request.resource.data.organizationId is string
        && request.resource.data.organizationId.size() <= 120
        && request.resource.data.commonName is string
        && request.resource.data.commonName.size() > 0
        && request.resource.data.commonName.size() <= 120
        && (!request.resource.data.keys().hasAny(['commonNameEn']) || (
          request.resource.data.commonNameEn is string
          && request.resource.data.commonNameEn.size() > 0
          && request.resource.data.commonNameEn.size() <= 120
        ))
        && (!request.resource.data.keys().hasAny(['commonNameFr']) || (
          request.resource.data.commonNameFr is string
          && request.resource.data.commonNameFr.size() > 0
          && request.resource.data.commonNameFr.size() <= 120
        ))
        && request.resource.data.scientificName is string
        && request.resource.data.scientificName.size() <= 160
        && (!request.resource.data.keys().hasAny(['fact']) || (
          request.resource.data.fact is string
          && request.resource.data.fact.size() > 0
          && request.resource.data.fact.size() <= 500
        ))
        && (!request.resource.data.keys().hasAny(['factEn']) || (
          request.resource.data.factEn is string
          && request.resource.data.factEn.size() > 0
          && request.resource.data.factEn.size() <= 500
        ))
        && (!request.resource.data.keys().hasAny(['factFr']) || (
          request.resource.data.factFr is string
          && request.resource.data.factFr.size() > 0
          && request.resource.data.factFr.size() <= 500
        ))
        && request.resource.data.normalizedSpeciesKey is string
        && request.resource.data.normalizedSpeciesKey.matches('[a-z0-9][a-z0-9-]{0,99}')
        && request.resource.data.confidence is number
        && request.resource.data.confidence >= 0.75
        && request.resource.data.confidence <= 1
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 500
        && (!request.resource.data.keys().hasAny(['reasonEn']) || (
          request.resource.data.reasonEn is string
          && request.resource.data.reasonEn.size() > 0
          && request.resource.data.reasonEn.size() <= 500
        ))
        && (!request.resource.data.keys().hasAny(['reasonFr']) || (
          request.resource.data.reasonFr is string
          && request.resource.data.reasonFr.size() > 0
          && request.resource.data.reasonFr.size() <= 500
        ))
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt == request.resource.data.createdAt
        && request.resource.data.status == 'reward_owed'
        && request.resource.data.bugDexBugId == null
        && request.resource.data.reviewThumbnailDataUrl is string
        && request.resource.data.reviewThumbnailDataUrl.size() <= 220000
        && request.resource.data.reviewThumbnailDataUrl.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+');
      allow read: if developer();
      allow update: if developer()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'bugDexBugId', 'updatedAt'])
        && request.resource.data.status in ['reward_owed', 'approved', 'rejected']
        && (request.resource.data.bugDexBugId == null || request.resource.data.bugDexBugId is string)
        && request.resource.data.updatedAt is string;
      allow delete: if developer();
    }

    match /organizationInvites/{inviteId} {
      allow read: if signedIn()
        && (organizationAdmin(resource.data.organizationId) || inviteTargetsCurrentUser(resource.data));
      allow create: if validInviteCreate()
        && request.resource.data.id == inviteId;
      allow update: if cancelInvite() || acceptInvite() || declineInvite() || renameInviteOrganizationUpdate();
      allow delete: if false;
    }

    match /duelSeasons/{seasonId} {
      allow read: if signedIn();
      allow create, update, delete: if false;
    }

    match /trades/{tradeId} {
      allow read: if signedIn()
        && (resource.data.fromUserId == request.auth.uid || resource.data.toUserId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.id == tradeId
        && request.resource.data.fromUserId == request.auth.uid
        && request.resource.data.toUserId is string
        && request.resource.data.toUserId != request.auth.uid
        && request.resource.data.fromUserName is string
        && request.resource.data.toUserName is string
        && request.resource.data.offerBugId is string
        && request.resource.data.requestBugId is string
        && (
          !request.resource.data.keys().hasAny(['offerBugIds', 'requestBugIds'])
          || (
            request.resource.data.offerBugIds is list
            && request.resource.data.offerBugIds.size() > 0
            && request.resource.data.offerBugIds.size() <= 6
            && request.resource.data.offerBugIds.hasAll([request.resource.data.offerBugId])
            && request.resource.data.requestBugIds is list
            && request.resource.data.requestBugIds.size() > 0
            && request.resource.data.requestBugIds.size() <= 6
            && request.resource.data.requestBugIds.hasAll([request.resource.data.requestBugId])
          )
        )
        && request.resource.data.offerBugId != request.resource.data.requestBugId
        && request.resource.data.status == 'Open'
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string;
      allow update: if signedIn()
        && resource.data.status == 'Open'
        && request.resource.data.updatedAt is string
        && (
          (
            resource.data.fromUserId == request.auth.uid
            && request.resource.data.status == 'Geannuleerd'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
          || (
            resource.data.toUserId == request.auth.uid
            && request.resource.data.status in ['Geaccepteerd', 'Afgewezen']
            && (
              (
                request.resource.data.status == 'Afgewezen'
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
              )
              || (
                request.resource.data.status == 'Geaccepteerd'
                && !multiTrade(resource.data)
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
              )
              || (
                request.resource.data.status == 'Geaccepteerd'
                && multiTrade(resource.data)
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'acceptedBugCount'])
                && request.resource.data.acceptedBugCount == resource.data.offerBugIds.size() + resource.data.requestBugIds.size()
              )
            )
          )
        );
      allow delete: if false;
    }

    match /bugSmashDuels/{duelId} {
      allow read: if signedIn() && (isDuelParticipant(resource.data) || (resource.data.matchType == 'random' && resource.data.status == 'pending' && resource.data.toUserId == 'random'));
      allow create: if validDuelCreate(duelId);
      allow update: if acceptOrDeclineDuel()
        || claimOpenRandomDuel()
        || cancelOwnDuel()
        || submitOwnDuelScore()
        || claimOwnDuelReward()
        || acknowledgeDuelResult();
      allow delete: if false;
    }

    match /arcadeGameResults/{mode}/runs/{runId} {
      allow read: if signedIn() && validArcadeResultMode(mode) && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && validArcadeRunData(mode);
      allow update, delete: if false;
    }
  }
}
